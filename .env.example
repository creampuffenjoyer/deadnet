# DEADNET — Environment Configuration
# Copy this to .env and fill in your values

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://deadnet:deadnet_pass@postgres:5432/deadnet

# Redis connection string
REDIS_URL=redis://redis:6379/0

# JWT secret key — CHANGE THIS before any non-local deployment
# Must be at least 32 characters
SECRET_KEY=deadnet-super-secret-key-change-in-production-please-32chars

# JWT algorithm (HS256 recommended for local)
ALGORITHM=HS256

# Access token lifetime in minutes (short-lived)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (long-lived)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seeded admin credentials (created on first startup if no admin exists)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@deadnet.local
ADMIN_PASSWORD=Admin@Deadnet1

# Architect shadow accounts — NO database rows, purely cryptographic
# ARCHITECT_SECRET: one shared 64-char random hex used to sign all Architect JWTs
#   Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#   IMPORTANT: keep this secret separate from SECRET_KEY
# Add more Architects by incrementing the number (ARCHITECT_4_CALLSIGN, etc.)
ARCHITECT_SECRET=GENERATE_64_CHAR_RANDOM_HEX_STRING_HERE
ARCHITECT_1_CALLSIGN=s0L
ARCHITECT_1_PASSWORD=CHANGE_THIS
ARCHITECT_2_CALLSIGN=ORG_1
ARCHITECT_2_PASSWORD=CHANGE_THIS
ARCHITECT_3_CALLSIGN=ORG_2
ARCHITECT_3_PASSWORD=CHANGE_THIS
# ARCHITECT_4_CALLSIGN=...
# ARCHITECT_4_PASSWORD=...

# SMTP / Email — Gmail with App Password
# Enable 2FA on your Gmail, then generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_DEADNET_GMAIL@gmail.com
SMTP_PASSWORD=YOUR_16_CHAR_APP_PASSWORD
SMTP_FROM_NAME=DEADNET
SMTP_FROM_EMAIL=YOUR_DEADNET_GMAIL@gmail.com
SMTP_TLS=true
SMTP_SSL=false

# Frontend URL — controls where email verification/reset links point
# Local dev:       http://localhost:5173
# Organization LAN:  http://192.168.1.XXX:5173
# Production:      https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# Backend API URL — used by the frontend browser to call the API
# Local dev (default, no change needed):
VITE_API_URL=http://localhost:8000
# ngrok / same-origin (frontend served as static files from backend):
# VITE_API_URL=
# LAN deployment:
# VITE_API_URL=http://192.168.1.100:8000

# Void route — encoded path to VoidBoard. Do not share — this is the void path.
# Generate: python -c "import base64,secrets; s=secrets.token_hex(8); print(base64.b64encode(('/'+s).encode()).decode())"
VITE_VOID_B64=GENERATE_BASE64_OF_SLASH_PLUS_16CHAR_RANDOM
